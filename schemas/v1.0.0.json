{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MuktadirHassan/quotes/main/schemas/v1.0.0.json",
  "title": "Quotes collection",
  "description": "Format for version 1.0.0 of the Quotes collection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "datasetVersion", "quotes"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "quotes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quote"
      }
    }
  },
  "$defs": {
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "attributedTo", "source", "language", "tags", "verification"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "attributedTo": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "originalText": {
          "type": "string",
          "minLength": 1
        },
        "translator": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["anime", "book", "film", "game", "interview", "manga", "person", "speech", "television", "other"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "creator": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["unverified", "verified", "disputed"]
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        },
        "evidenceUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "required": ["evidenceUrl"]
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["public-domain", "licensed", "copyrighted", "unknown"]
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "holder": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
